#!name = 滴滴出行去广告(简化版)
#!desc = 不依赖任何脚本,只用 reject / reject-dict / jsonjq(圈X内置),去开屏、弹窗、首页挂件,精简首页和我的页面
#!author = dudu
#!update = 2026-11-20

# ========== 开屏、弹窗、活动挂件:直接拦掉 ==========
# 开屏广告图片
^https:\/\/img-ys011\.didistatic\.com\/static url reject
^https:\/\/pt-starimg\.didistatic\.com\/static url reject
# 首页悬浮活动挂件
^https:\/\/res\.xiaojukeji\.com\/resapi\/activity\/mget url reject
^https:\/\/res\.xiaojukeji\.com\/resapi\/activity\/getMulti\? url reject-dict
^https:\/\/res\.xiaojukeji\.com\/resapi\/activity\/xpget url reject-dict
^https:\/\/res\.xiaojukeji\.com\/resapi\/activity\/getInsActivityV2 url reject-dict
# 安全提示横幅
^https:\/\/guard\.sec\.xiaojukeji\.com\/api\/guard\/psg\/v2\/getShieldStatus url reject
# 底部打车/代叫推荐、福利专区入口
^https:\/\/conf\.diditaxi\.com\.cn\/one url reject
^https:\/\/conf\.diditaxi\.com\.cn\/nav\/widget url reject
# 首页领任务、动态模块
^https:\/\/conf\.diditaxi\.com\.cn\/api\/(component|fusion|dynamicmodule|usercenter) url reject
^https:\/\/conf\.diditaxi\.com\.cn\/dynamic url reject
# 商城
^https:\/\/shop-gw\.chengxinyouxuan\.com\/(route|indexConfig|apolloConfig|getShopTuanInfos) url reject

# ========== 首页、我的页面:只留叫车相关的,多余卡片去掉 ==========
# 首页:只留打车、代驾、骑行、车主服务、更多;底部只留首页、我的;顶部去掉旅行、车主
^https:\/\/conf\.diditaxi\.com\.cn\/homepage\/v\d\/core url jsonjq-response-body '.data.order_cards.nav_list_card.data |= map(select(.nav_id == "dache_anycar" or .nav_id == "driverservice" or .nav_id == "bike" or .nav_id == "carmate" or .nav_id == "nav_more_v3")) | .data.disorder_cards.bottom_nav_list.data |= map(select(.id == "v6x_home" or .id == "home_page" or .id == "user_center")) | .data.disorder_cards.top_nav_list.data.top_nav_info |= map(select(.name != "旅行" and .name != "车主"))'
# 我的页面:去掉天天领福利、金融服务、更多服务、企业服务、安全中心;钱包只留优惠券
^https:\/\/common\.diditaxi\.com\.cn\/common\/v\d\/usercenter\/me url jsonjq-response-body '.data.cards |= (map(select(.title != "天天领福利" and .title != "金融服务" and .title != "更多服务" and .title != "企业服务" and .title != "安全中心")) | map(if .tag == "wallet" then (.items |= map(select(.title == "优惠券"))) else . end))'
# 优惠商城入口去掉
^https:\/\/api\.udache\.com\/gulfstream\/pre-sale\/v1\/other\/pGetSceneList url jsonjq-response-body '.data.scene_list |= map(select(.text != "优惠商城")) | .data.show_data |= map(.scene_ids |= map(select(. != "scene_coupon_mall")))'

hostname = guard.sec.xiaojukeji.com, conf.diditaxi.com.cn, api.udache.com, res.xiaojukeji.com, shop-gw.chengxinyouxuan.com, img-ys011.didistatic.com, pt-starimg.didistatic.com, common.diditaxi.com.cn
